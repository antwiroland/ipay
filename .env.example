# ─────────────────────────────────────────────────────────────
# iPay Ghana — environment variables
# Copy to .env.local for development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public base URL (used in payment callbacks and emails)
APP_URL=http://localhost:3000

# MongoDB — must be a replica set (transactions). Atlas works out of the box.
# Local: run `npm run db:dev` and use the URI it prints.
MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=ipay-dev
MONGODB_DB=ipay
# Build indexes automatically in production (otherwise run `npm run seed` or create them manually once)
MONGODB_AUTO_INDEX=false
# Optional (local only): explicit DNS resolvers if mongodb+srv lookups fail, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# Secrets — generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
APP_ENCRYPTION_KEY=
ID_HASH_SECRET=
CRON_SECRET=

# Payments: "mock" (development sandbox) or "paystack"
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Mock provider is refused when NODE_ENV=production unless this is "true" (staging demos only)
ALLOW_MOCK_PAYMENTS=false
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# Email (Resend). Without it, emails are printed to the console in development.
RESEND_API_KEY=
EMAIL_FROM="iPay Ghana <no-reply@ipayghana.com>"

# SMS (Hubtel). Without it, SMS are printed to the console in development.
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER=iPayGhana

# Image storage (Cloudinary). Required in production; development falls back to public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated external hosts allowed as banner destinations (https only). Internal paths are always allowed.
ALLOWED_PROMO_HOSTS=

# Development only
DISABLE_RATE_LIMIT=false
